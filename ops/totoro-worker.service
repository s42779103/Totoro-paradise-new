[Unit]
Description=Totoro delayed run worker
After=network-online.target redis-server.service
Wants=network-online.target
Requires=redis-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/totoro-runtime/current
Environment=NODE_ENV=production
Environment=TZ=Asia/Shanghai
Environment=REDIS_URL=redis://127.0.0.1:6379
Environment=SUNRUN_MINIPROGRAM_BASE_URL=https://wxxcx.xtotoro.com
Environment=SUNRUN_MINIPROGRAM_FALLBACK_BASE_URL=https://app.xtotoro.com
ExecCondition=/usr/bin/test -f /opt/totoro-runtime/current/scripts/run-worker.js
ExecStart=/usr/bin/node /opt/totoro-runtime/current/scripts/run-worker.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
